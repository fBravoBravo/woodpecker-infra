# ===========================================
# Base Configuration (Standalone Traefik Setup)
# ===========================================
BASE_DOMAIN=yourdomain.com
ACME_EMAIL=your-email@example.com

# Traefik Dashboard Auth (user:password - bcrypt recommended)
# Generate with: htpasswd -nbB admin "yourpassword"
TRAEFIK_AUTH=admin:$$2y$$10$$...

# ===========================================
# Woodpecker CI
# ===========================================
WOODPECKER_DOMAIN=ci.yourdomain.com
WOODPECKER_AGENT_SECRET=$(openssl rand -hex 32)
WOODPECKER_ADMIN_USERS=your-github-username

# GitHub OAuth App credentials
# Create at: https://github.com/settings/developers
GITHUB_CLIENT=your-github-client-id
GITHUB_SECRET=your-github-client-secret

# ===========================================
# Docker Registry
# ===========================================
REGISTRY_DOMAIN=registry.yourdomain.com

# Registry credentials (for docker login)
REGISTRY_USER=registryuser
REGISTRY_PASSWORD=registrypassword

# ===========================================
# Coolify Deployment (Alternative Setup)
# ===========================================
# When deploying inside Coolify, use these variables instead.
# Coolify handles SSL/Traefik — see COOLIFY.md for full guide.
# WOODPECKER_HOST=https://ci.yourdomain.com
